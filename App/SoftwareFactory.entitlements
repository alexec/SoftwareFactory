<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The direct-download build, signed with Developer ID and notarised. The sandbox is off
  so the app can start an agent in your own environment: ~/.claude, the keychain, git,
  node, Xcode. A sandboxed child gets none of that.

  App/SoftwareFactory-AppStore.entitlements is the same app with the sandbox on, for the
  Mac App Store, which takes nothing else. Add an entitlement here and add it there too:
  neither file is generated any more, because xcodegen writes one file per target and
  would put the same one in every configuration. (T163, 13 Sep 2026.)

  What each one is for:
    app-sandbox                   off here, on for the store
    network.server                the factory listens on 4747: MCP for agents, and a
                                  small API for the phone
    network.client                outgoing, for iCloud
    device.audio-input            dictating a task
    files.user-selected.read-write  choosing the folder a project runs in; without it the
                                  sandboxed build's open panel is refused and the button
                                  looks broken (Alex, 12 Sep 2026)
    application-groups            where the shared store lives
    icloud-*                      CloudKit, so the phone reads the floor off the network
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.alexecollins.softwarefactory</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6T4RVD5724.com.alexecollins.softwarefactory</string>
	</array>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
